APP_NAME="Biblioteca Activa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=biblioteca_activa
DB_USERNAME=postgres
DB_PASSWORD=

# Supabase: activa esta conexión en un entorno remoto con DB_CONNECTION=supabase.
# Puedes usar SUPABASE_DB_URL o completar los valores individuales del proyecto.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
# Para Session Pooler usa postgres.[PROJECT-REF]; para conexión directa usa postgres.
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SCHEMA=biblioteca
SUPABASE_DB_SSLMODE=require
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_REGION=
# Ejemplo: https://PROJECT-REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ENDPOINT=
# URL pública base del bucket avatars, si el bucket será público.
SUPABASE_STORAGE_PUBLIC_URL=
AVATAR_DISK=public

MONGO_DB_URI=mongodb://127.0.0.1:27017
MONGO_DB_DATABASE=biblioteca_activa

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="biblioteca@example.test"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
